// CareerUttsavAdmin — Prisma 7 V1 schema (definition only; not migrated yet)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum EventStatus {
  Draft
  Published
  Live
  Completed
  Archived
}

enum RegistrationKind {
  student
  school
  partner_registration
  student_ambassador
}

enum RegistrationStatus {
  Confirmed
  CheckedIn @map("Checked In")
}

enum PaymentStatus {
  Paid
  Pending
  Waived
}

enum RegistrationSource {
  WHATSAPP
  WEBSITE
  DIRECT_ENTRY
  UNKNOWN
}

enum RegistrationAttemptSource {
  WHATSAPP
  WEBSITE
}

enum RegistrationAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum RegistrationAttemptStep {
  WELCOME
  STARTED
  NAME
  EMAIL
  CLASS
  GENDER
  BOARD
  STREAM
  SCHOOL_COLLEGE
  CITY
  SEMINAR_SELECTION
  FINISH_REGISTRATION
  YOU
  ACADEMICS
  INTERESTS
}

enum Gender {
  Male
  Female
  Other
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id                   String      @id
  title                String
  slug                 String
  description          String
  shortDescription     String?
  status               EventStatus
  venue                String
  address              String
  city                 String
  state                String
  pincode              String
  startDate            String
  endDate              String
  startTime            String
  endTime              String
  hallCount            Int
  registrationDeadline DateTime
  maxCapacity          Int
  /// Stored operational counter — do not recalculate from registration row count.
  registrationCount    Int
  /// Stored operational counter — do not recalculate from registration row count.
  checkInCount         Int
  bannerImage          String?
  isFeatured           Boolean
  tags                 String[]
  createdBy            String
  createdAt            DateTime
  updatedAt            DateTime

  seminars                 Seminar[]
  registrations            Registration[]
  partnerEventLinks        PartnerEventLink[]
  partnerEventPartnerships PartnerEventPartnership[]
  seminarSessionRosters    SeminarSessionRoster[]
  registrationAttempts     RegistrationAttempt[]

  @@map("events")
}

// ─── Seminars ────────────────────────────────────────────────────────────────

model Seminar {
  id            String @id
  eventId       String
  title         String
  date          String?
  startTime     String?
  endTime       String?
  panelistSlots Int?
  hall          Int?

  event                         Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationSeminars          RegistrationSeminar[]
  partnerSeminarSlotAssignments PartnerSeminarSlotAssignment[]
  seminarSessionRoster          SeminarSessionRoster?

  @@unique([id, eventId])
  @@index([eventId])
  @@map("seminars")
}

// ─── Seminar session speaker rosters (Admin-managed stage programming) ───────

model SeminarSessionRoster {
  eventId    String
  seminarId  String
  /// Moderator speaker JSON, or null when unset.
  moderator  Json?
  /// Ordered panelist speaker JSON array — order is meaningful.
  panelists  Json     @default("[]")
  topicBrief String?
  notes      String?
  updatedAt  DateTime

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seminar Seminar @relation(fields: [seminarId, eventId], references: [id, eventId], onDelete: Cascade)

  @@id([eventId, seminarId])
  @@unique([seminarId, eventId])
  @@index([seminarId])
  @@map("seminar_session_rosters")
}

// ─── Registrations ───────────────────────────────────────────────────────────

model Registration {
  id                 String             @id
  registrationNumber String             @unique
  kind               RegistrationKind
  /// Where the student registration was completed. Non-students stay UNKNOWN.
  source             RegistrationSource @default(UNKNOWN)
  eventId            String
  eventTitle         String
  status             RegistrationStatus
  paymentStatus      PaymentStatus
  registeredAt       DateTime
  updatedAt          DateTime
  amount             Decimal?           @db.Decimal(12, 2)
  checkInTime        DateTime?

  // Student fields
  studentName      String?
  email            String?
  phone            String?
  parentPhone      String?
  college          String?
  classLabel       String?
  interestedStream String?
  board            String?
  gender           Gender?
  city             String?
  state            String?
  course           String?
  year             String?
  emailNormalized  String?
  phoneLast10      String?

  // School fields
  schoolContactName   String?
  schoolName          String?
  schoolCity          String?
  schoolContactNumber String?
  schoolContactEmail  String?

  // Exhibitor / partner registration fields (public registration, not Partner Portal)
  partnerRegContactName     String?
  partnerRegInstitutionName String?
  partnerRegCity            String?
  partnerRegContactNumber   String?
  partnerRegContactEmail    String?

  // Student ambassador fields
  ambassadorName          String?
  ambassadorClass         String?
  ambassadorSchoolCollege String?
  ambassadorAge           Int?
  ambassadorPhone         String?
  ambassadorEmail         String?

  event                 Event                              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registrationSeminars  RegistrationSeminar[]
  whatsAppConversation  WhatsAppRegistrationConversation?
  registrationAttempts  RegistrationAttempt[]

  @@unique([eventId, emailNormalized])
  @@unique([eventId, phoneLast10])
  @@index([eventId])
  @@index([kind])
  @@index([eventId, kind])
  @@map("registrations")
}

// ─── Registration ↔ Seminar interests ────────────────────────────────────────

model RegistrationSeminar {
  id             String  @id
  registrationId String
  seminarId      String?
  seminarTitle   String

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  seminar      Seminar?     @relation(fields: [seminarId], references: [id], onDelete: SetNull)

  @@unique([registrationId, seminarTitle])
  @@index([registrationId])
  @@index([seminarId])
  @@map("registration_seminars")
}

// ─── Registration number counters (global by prefix) ─────────────────────────

// Partial registration progress. Completed registrations stay in Registration.
// One current IN_PROGRESS row per event + source + phone is enforced by a
// partial unique index in SQL and by the attempt service. Historical
// ABANDONED / COMPLETED rows for the same phone are allowed.

model RegistrationAttempt {
  id                       String                      @id
  eventId                  String
  source                   RegistrationAttemptSource
  status                   RegistrationAttemptStatus
  phone                    String
  phoneLast10              String?
  email                    String?
  emailNormalized          String?
  name                     String?
  classLabel               String?
  gender                   Gender?
  board                    String?
  interestedStream         String?
  college                  String?
  city                     String?
  seminarInterests         String[]                    @default([])
  lastStep                 RegistrationAttemptStep
  startedAt                DateTime
  lastActivityAt           DateTime
  completedAt              DateTime?
  completedRegistrationId  String?
  whatsappWaId             String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  event                  Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  completedRegistration  Registration?   @relation(fields: [completedRegistrationId], references: [id], onDelete: SetNull)
  whatsappConversation   WhatsAppRegistrationConversation?

  @@index([eventId, status])
  @@index([eventId, source, phoneLast10])
  @@index([emailNormalized])
  @@index([whatsappWaId])
  @@index([completedRegistrationId])
  @@map("registration_attempts")
}

model RegistrationNumberCounter {
  prefix    String   @id
  nextValue Int
  updatedAt DateTime

  @@map("registration_number_counters")
}

// ─── SPOCs (relationship managers) ───────────────────────────────────────────

model Spoc {
  id              String   @id
  name            String
  organization    String
  phone           String
  email           String
  emailNormalized String   @unique
  createdAt       DateTime
  updatedAt       DateTime

  partners Partner[] @relation("PartnerRelationshipSpoc")

  @@index([organization])
  @@map("spocs")
}

// ─── Partners (sales + portal) ───────────────────────────────────────────────

model Partner {
  id    String @id
  name  String
  city  String @default("")
  state String @default("")
  stage String

  primaryContact   Json
  secondaryContact Json

  relationshipOrganization String  @default("")
  relationshipManagerName  String  @default("")
  relationshipManagerPhone String  @default("")
  relationshipManagerEmail String  @default("")
  relationshipSpocId       String?
  relationshipSpoc         Spoc?   @relation("PartnerRelationshipSpoc", fields: [relationshipSpocId], references: [id], onDelete: SetNull)

  stageRemarks Json @default("[]")
  meetings     Json @default("[]")

  contactedAt         String?
  contactedNotes      String?
  meetingAt           String?
  meetingNotes        String?
  notProceedingAt     String?
  notProceedingReason String?

  sponsorshipTier         String?
  sponsorshipNotes        String?
  /// Legacy flat deliverable checklist when eventPartnerships was not used.
  legacyDeliverables      Json?
  deliverablesConfirmedAt DateTime?
  seminarSlotsConfirmedAt DateTime?

  totalAmount            Decimal?  @db.Decimal(12, 2)
  discountAmount         Decimal?  @db.Decimal(12, 2)
  netAmount              Decimal?  @db.Decimal(12, 2)
  commercialsConfirmedAt DateTime?

  portalLogin                   String?
  portalLoginNormalized         String?   @unique
  portalInviteEmail             String?
  portalInviteEmailNormalized   String?   @unique
  portalPasswordHash            String?
  portalAuthVersion             Int       @default(0)
  portalPasswordChangedAt       DateTime?
  portalPasswordPromptSkippedAt DateTime?
  portalInviteSentAt            DateTime?
  /// Explicit portal login switch. Stage is not an access control.
  portalAccessEnabled           Boolean   @default(false)

  passwordResetTokens PartnerPasswordResetToken[]
  communicationLogs   PartnerCommunicationLog[]

  portalDocuments       Json?
  portalFasciaName      String?
  portalWebsiteUrl      String?
  portalSmsContent      String?
  portalSeminarSpeakers Json?
  portalRepresentatives Json?

  createdAt DateTime
  updatedAt DateTime

  eventLinks        PartnerEventLink[]
  eventPartnerships PartnerEventPartnership[]

  @@index([stage])
  @@index([relationshipSpocId])
  @@map("partners")
}

model PartnerPasswordResetToken {
  id        String    @id @default(cuid())
  partnerId String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([expiresAt])
  @@map("partner_password_reset_tokens")
}

model PartnerEventLink {
  partnerId String
  eventId   String

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([partnerId, eventId])
  @@index([eventId])
  @@map("partner_event_links")
}

model PartnerEventPartnership {
  id               String  @id
  partnerId        String
  eventId          String
  sponsorshipTier  String?
  customTierLabel  String?
  deliverables            Json @default("[]")
  seminarSlotCount        Int  @default(0)
  /// Admin-owned count of on-ground event representative forms for this partner.
  representativeSlotCount Int  @default(0)
  /// Last successful partner-originated change to submission data for this event.
  partnerPortalLastActivityAt DateTime?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  seminarSlotAssignments PartnerSeminarSlotAssignment[]

  @@unique([partnerId, eventId])
  @@index([eventId])
  @@map("partner_event_partnerships")
}

model PartnerSeminarSlotAssignment {
  id            String  @id
  partnershipId String
  seminarId     String
  slots         Int
  seminarTitle  String?

  partnership PartnerEventPartnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  seminar     Seminar                 @relation(fields: [seminarId], references: [id], onDelete: Restrict)

  @@unique([partnershipId, seminarId])
  @@index([seminarId])
  @@map("partner_seminar_slot_assignments")
}

model PartnerCommunicationLog {
  id                 String   @id
  partnerId          String
  eventPartnershipId String?
  eventId            String?
  communicationType  String
  triggerType        String
  sentAt             DateTime
  outcome            String
  /// Address the message was accepted for. Not updated if the partner email changes later.
  recipientEmail     String   @default("")
  messageId          String?
  metadata           Json?
  createdAt          DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, communicationType])
  @@index([partnerId, eventId, sentAt])
  @@map("partner_communication_logs")
}

// ─── Admin users / auth ──────────────────────────────────────────────────────

enum AdminUserStatus {
  Active
  Inactive
  Suspended
  PendingApproval @map("Pending Approval")
  Rejected
}

enum AdminRole {
  user
  superuser
}

model AdminUser {
  id                  String                  @id
  name                String
  email               String                  @unique
  phone               String?
  avatar              String?
  role                AdminRole
  roleId              String
  status              AdminUserStatus
  department          String?
  passwordHash        String
  authVersion         Int                     @default(0)
  lastLogin           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  passwordResetTokens AdminPasswordResetToken[]

  @@index([role])
  @@index([status])
  @@map("admin_users")
}

model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_password_reset_tokens")
}

// ─── WhatsApp registration conversations (temporary workflow state) ───────────

enum WhatsAppConversationStatus {
  ACTIVE
  READY_TO_REGISTER
  COMPLETED
  CANCELLED
}

enum WhatsAppConversationStep {
  AWAITING_START
  AWAITING_NAME
  AWAITING_EMAIL
  AWAITING_CLASS
  AWAITING_GENDER
  AWAITING_BOARD
  AWAITING_STREAM
  AWAITING_COLLEGE
  AWAITING_CITY
  AWAITING_SEMINARS
  AWAITING_SEMINAR_FINISH
  READY_TO_REGISTER
  COMPLETED
  CANCELLED
}

enum WhatsAppPostRegistrationTriggerKind {
  INSTAGRAM
  PARENT_INVITE
  FRIEND_INVITE
}

enum WhatsAppPostRegistrationTriggerStatus {
  PENDING
  CLAIMED
  SENT
  CANCELLED
}

model WhatsAppRegistrationConversation {
  id                 String                     @id @default(cuid())
  waId               String                     @unique
  status             WhatsAppConversationStatus @default(ACTIVE)
  currentStep        WhatsAppConversationStep   @default(AWAITING_START)
  studentName        String?
  email              String?
  classLabel         String?
  gender             Gender?
  board              String?
  interestedStream   String?
  college            String?
  city               String?
  selectedSeminarIds Json                       @default("[]")
  completedRegistrationId String?               @unique
  registrationAttemptId  String?               @unique
  lastInboundAt          DateTime?
  highestReminderStageSent Int                @default(0)
  lastReminderAttemptAt  DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  expiresAt          DateTime

  completedRegistration Registration?       @relation(fields: [completedRegistrationId], references: [id], onDelete: SetNull)
  registrationAttempt   RegistrationAttempt? @relation(fields: [registrationAttemptId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([expiresAt])
  @@map("whatsapp_registration_conversations")
}

model WhatsAppPostRegistrationTrigger {
  id             String                                 @id @default(cuid())
  waId           String
  registrationId String
  kind           WhatsAppPostRegistrationTriggerKind
  dueAt          DateTime
  status         WhatsAppPostRegistrationTriggerStatus @default(PENDING)
  claimedAt      DateTime?
  sentAt         DateTime?
  attemptCount   Int                                    @default(0)
  lastError      String?
  createdAt      DateTime                               @default(now())
  updatedAt      DateTime                               @updatedAt

  @@unique([registrationId, kind])
  @@index([status, dueAt])
  @@map("whatsapp_post_registration_triggers")
}

model WhatsAppInboundMessage {
  id          String    @id @default(cuid())
  messageId   String    @unique
  waId        String
  messageType String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([waId])
  @@map("whatsapp_inbound_messages")
}
