// CareerUttsavAdmin — Prisma 7 V1 schema (definition only; not migrated yet)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum EventStatus {
  Draft
  Published
  Live
  Completed
  Archived
}

enum RegistrationKind {
  student
  school
  partner_registration
  student_ambassador
}

enum RegistrationStatus {
  Confirmed
  CheckedIn @map("Checked In")
}

enum PaymentStatus {
  Paid
  Pending
  Waived
}

enum Gender {
  Male
  Female
  Other
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id                   String      @id
  title                String
  slug                 String
  description          String
  shortDescription     String?
  status               EventStatus
  venue                String
  address              String
  city                 String
  state                String
  pincode              String
  startDate            String
  endDate              String
  startTime            String
  endTime              String
  hallCount            Int
  registrationDeadline DateTime
  maxCapacity          Int
  /// Stored operational counter — do not recalculate from registration row count.
  registrationCount    Int
  /// Stored operational counter — do not recalculate from registration row count.
  checkInCount         Int
  bannerImage          String?
  isFeatured           Boolean
  tags                 String[]
  createdBy            String
  createdAt            DateTime
  updatedAt            DateTime

  seminars                 Seminar[]
  registrations            Registration[]
  partnerEventLinks        PartnerEventLink[]
  partnerEventPartnerships PartnerEventPartnership[]
  seminarSessionRosters    SeminarSessionRoster[]

  @@map("events")
}

// ─── Seminars ────────────────────────────────────────────────────────────────

model Seminar {
  id            String @id
  eventId       String
  title         String
  date          String
  startTime     String
  endTime       String
  panelistSlots Int
  hall          Int

  event                         Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationSeminars          RegistrationSeminar[]
  partnerSeminarSlotAssignments PartnerSeminarSlotAssignment[]
  seminarSessionRoster          SeminarSessionRoster?

  @@unique([id, eventId])
  @@index([eventId])
  @@map("seminars")
}

// ─── Seminar session speaker rosters (Admin-managed stage programming) ───────

model SeminarSessionRoster {
  eventId    String
  seminarId  String
  /// Moderator speaker JSON, or null when unset.
  moderator  Json?
  /// Ordered panelist speaker JSON array — order is meaningful.
  panelists  Json     @default("[]")
  topicBrief String?
  notes      String?
  updatedAt  DateTime

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seminar Seminar @relation(fields: [seminarId, eventId], references: [id, eventId], onDelete: Cascade)

  @@id([eventId, seminarId])
  @@unique([seminarId, eventId])
  @@index([seminarId])
  @@map("seminar_session_rosters")
}

// ─── Registrations ───────────────────────────────────────────────────────────

model Registration {
  id                 String             @id
  registrationNumber String             @unique
  kind               RegistrationKind
  eventId            String
  eventTitle         String
  status             RegistrationStatus
  paymentStatus      PaymentStatus
  registeredAt       DateTime
  updatedAt          DateTime
  amount             Decimal?           @db.Decimal(12, 2)
  checkInTime        DateTime?

  // Student fields
  studentName      String?
  email            String?
  phone            String?
  parentPhone      String?
  college          String?
  classLabel       String?
  interestedStream String?
  board            String?
  gender           Gender?
  city             String?
  state            String?
  course           String?
  year             String?
  emailNormalized  String?
  phoneLast10      String?

  // School fields
  schoolContactName   String?
  schoolName          String?
  schoolCity          String?
  schoolContactNumber String?
  schoolContactEmail  String?

  // Exhibitor / partner registration fields (public registration, not Partner Portal)
  partnerRegContactName     String?
  partnerRegInstitutionName String?
  partnerRegCity            String?
  partnerRegContactNumber   String?
  partnerRegContactEmail    String?

  // Student ambassador fields
  ambassadorName          String?
  ambassadorClass         String?
  ambassadorSchoolCollege String?
  ambassadorAge           Int?
  ambassadorPhone         String?
  ambassadorEmail         String?

  event                Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registrationSeminars RegistrationSeminar[]

  @@unique([eventId, emailNormalized])
  @@unique([eventId, phoneLast10])
  @@index([eventId])
  @@index([kind])
  @@index([eventId, kind])
  @@map("registrations")
}

// ─── Registration ↔ Seminar interests ────────────────────────────────────────

model RegistrationSeminar {
  id             String  @id
  registrationId String
  seminarId      String?
  seminarTitle   String

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  seminar      Seminar?     @relation(fields: [seminarId], references: [id], onDelete: SetNull)

  @@unique([registrationId, seminarTitle])
  @@index([registrationId])
  @@index([seminarId])
  @@map("registration_seminars")
}

// ─── Registration number counters (global by prefix) ─────────────────────────

model RegistrationNumberCounter {
  prefix    String   @id
  nextValue Int
  updatedAt DateTime

  @@map("registration_number_counters")
}

// ─── SPOCs (relationship managers) ───────────────────────────────────────────

model Spoc {
  id              String   @id
  name            String
  organization    String
  phone           String
  email           String
  emailNormalized String   @unique
  createdAt       DateTime
  updatedAt       DateTime

  partners Partner[] @relation("PartnerRelationshipSpoc")

  @@index([organization])
  @@map("spocs")
}

// ─── Partners (sales + portal) ───────────────────────────────────────────────

model Partner {
  id    String @id
  name  String
  city  String @default("")
  state String @default("")
  stage String

  primaryContact   Json
  secondaryContact Json

  relationshipOrganization String  @default("")
  relationshipManagerName  String  @default("")
  relationshipManagerPhone String  @default("")
  relationshipManagerEmail String  @default("")
  relationshipSpocId       String?
  relationshipSpoc         Spoc?   @relation("PartnerRelationshipSpoc", fields: [relationshipSpocId], references: [id], onDelete: SetNull)

  stageRemarks Json @default("[]")
  meetings     Json @default("[]")

  contactedAt         String?
  contactedNotes      String?
  meetingAt           String?
  meetingNotes        String?
  notProceedingAt     String?
  notProceedingReason String?

  sponsorshipTier         String?
  sponsorshipNotes        String?
  /// Legacy flat deliverable checklist when eventPartnerships was not used.
  legacyDeliverables      Json?
  deliverablesConfirmedAt DateTime?
  seminarSlotsConfirmedAt DateTime?

  totalAmount            Decimal?  @db.Decimal(12, 2)
  discountAmount         Decimal?  @db.Decimal(12, 2)
  netAmount              Decimal?  @db.Decimal(12, 2)
  commercialsConfirmedAt DateTime?

  portalLogin                   String?
  portalLoginNormalized         String?   @unique
  portalInviteEmail             String?
  portalInviteEmailNormalized   String?   @unique
  portalPasswordHash            String?
  portalAuthVersion             Int       @default(0)
  portalPasswordChangedAt       DateTime?
  portalPasswordPromptSkippedAt DateTime?
  portalInviteSentAt            DateTime?

  portalDocuments       Json?
  portalFasciaName      String?
  portalWebsiteUrl      String?
  portalSmsContent      String?
  portalSeminarSpeakers Json?
  portalRepresentatives Json?

  createdAt DateTime
  updatedAt DateTime

  eventLinks        PartnerEventLink[]
  eventPartnerships PartnerEventPartnership[]

  @@index([stage])
  @@index([relationshipSpocId])
  @@map("partners")
}

model PartnerEventLink {
  partnerId String
  eventId   String

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([partnerId, eventId])
  @@index([eventId])
  @@map("partner_event_links")
}

model PartnerEventPartnership {
  id               String  @id
  partnerId        String
  eventId          String
  sponsorshipTier  String?
  customTierLabel  String?
  deliverables     Json    @default("[]")
  seminarSlotCount Int     @default(0)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  seminarSlotAssignments PartnerSeminarSlotAssignment[]

  @@unique([partnerId, eventId])
  @@index([eventId])
  @@map("partner_event_partnerships")
}

model PartnerSeminarSlotAssignment {
  id            String  @id
  partnershipId String
  seminarId     String
  slots         Int
  seminarTitle  String?

  partnership PartnerEventPartnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  seminar     Seminar                 @relation(fields: [seminarId], references: [id], onDelete: Restrict)

  @@unique([partnershipId, seminarId])
  @@index([seminarId])
  @@map("partner_seminar_slot_assignments")
}
