# Copy to .env.local and fill in real values.
# Do NOT put secrets in this file — it may be committed to git.

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key_here
# Verified sender in Resend, e.g. "Career Uttsav <noreply@careeruttsav.in>"
RESEND_FROM_EMAIL=Career Uttsav <onboarding@resend.dev>

# OTP hashing pepper (change in production)
OTP_HASH_SECRET=replace-with-a-long-random-secret

# SMS provider: "console" (logs OTP) or "twilio"
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
