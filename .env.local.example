# Copy to .env.local and fill in real values.
# Do NOT put secrets in this file — it may be committed to git.

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key_here
# Verified sender in Resend, e.g. "Career Uttsav <noreply@careeruttsav.in>"
RESEND_FROM_EMAIL=Career Uttsav <onboarding@resend.dev>

# Opaque phone verification token hashing (issued after OTP verify).
# Does NOT hash MSG91 OTP codes. Prefer this over legacy OTP_HASH_SECRET.
PHONE_VERIFICATION_TOKEN_SECRET=replace-with-a-long-random-secret

# OTP provider: "msg91" (default) or "mock" (local/dev only — never in production)
OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Local mock only (OTP_PROVIDER=mock): fixed OTP is 123456 — see README.
