# Copy to .env.local and fill in real values.
# Do NOT put secrets in this file — it may be committed to git.

# Transactional email provider: "resend" (default) or "smtp".
# Leave this as resend until Google Workspace SMTP relay is verified.
# A missing EMAIL_PROVIDER also stays on Resend.
EMAIL_PROVIDER=resend

# Resend (used when EMAIL_PROVIDER=resend or EMAIL_PROVIDER is unset)
RESEND_API_KEY=re_your_resend_api_key_here
# Verified sender in Resend, e.g. "Career Uttsav <noreply@careeruttsav.in>"
RESEND_FROM_EMAIL=Career Uttsav <onboarding@resend.dev>

# Google Workspace SMTP relay (used only when EMAIL_PROVIDER=smtp).
# Production is expected to authorize this server by IP in Google Workspace.
# Do not set a mailbox password for that relay.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_REQUIRE_TLS=true
SMTP_FROM_EMAIL=registrations@careeruttsav.in
SMTP_FROM_NAME=Career Uttsav
# EHLO hostname for the Google Workspace relay. The production relay closes
# the connection when this is omitted. Set it to the sending server's hostname.
SMTP_EHLO_NAME=ec2-65-2-156-37.ap-south-1.compute.amazonaws.com
# Optional SMTP AUTH. Leave both unset for the IP-authorized relay.
# Set both only if Workspace is later configured to require SMTP AUTH.
# SMTP_USER=
# SMTP_PASS=
# Admin login URL used in approval emails (optional)
# ADMIN_LOGIN_URL=https://admin.careeruttsav.in

# Opaque phone verification token hashing (issued after OTP verify).
# Does NOT hash MSG91 OTP codes. Prefer this over legacy OTP_HASH_SECRET.
# Required in production when OTP_PROVIDER=msg91.
PHONE_VERIFICATION_TOKEN_SECRET=replace-with-a-long-random-secret

# OTP provider: "msg91" (default) or "mock"
# Local development: OTP_PROVIDER=mock (fixed code 1234, shown as debugCode on the website)
# Production: OTP_PROVIDER=msg91 with MSG91 keys and PHONE_VERIFICATION_TOKEN_SECRET
# Hosted testing only: OTP_PROVIDER=mock + ALLOW_MOCK_OTP=true
OTP_PROVIDER=msg91
# ALLOW_MOCK_OTP=true
# MSG91_AUTH_KEY=
# MSG91 OTP Template ID from the MSG91 OTP section (not the DLT Template ID)
# MSG91_TEMPLATE_ID=

# CORS — comma-separated origins (optional; defaults include production domains)
# PUBLIC_SITE_ORIGINS=https://new.careeruttsav.in,https://www.careeruttsav.in
# PARTNER_PORTAL_ORIGINS=https://partners.careeruttsav.in,http://localhost:3001
# Partner portal origin used in access and password-reset links.
# NEXT_PUBLIC_PARTNER_PORTAL_URL=https://partners.careeruttsav.in
# PARTNER_PORTAL_APP_URL=https://partners.careeruttsav.in

# Shared server-to-server secret for CareerUttsavPartner → Admin API calls.
# Required for GET/PATCH /api/partner-portal/partners* and GET /api/partner-portal/events.
# Must match the same value in CareerUttsavPartner/.env.local.
PARTNER_PORTAL_SERVICE_SECRET=

# Admin session cookie signing (required for Admin login)
# ADMIN_SESSION_SECRET=

# Registration persistence: "json" (default) or "prisma"
# REGISTRATION_PERSISTENCE=json

# Partner/SPOC persistence: "json" (default) or "prisma"
# PARTNER_PERSISTENCE=json

# Supabase Postgres connection (required when using Prisma persistence modes)
# DATABASE_URL=postgresql://...

# Meta WhatsApp Cloud API
# WHATSAPP_VERIFY_TOKEN=
# META_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Required when WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID are set.
# Set this to the Graph API version configured for your Meta app (for example v22.0).
# WHATSAPP_GRAPH_API_VERSION=
# WHATSAPP_HTTP_TIMEOUT_MS=

# WhatsApp incomplete-registration reminders (Stage 2A cron)
# WHATSAPP_REGISTRATION_REMINDERS_ENABLED=false
# WHATSAPP_REMINDER_CRON_SECRET=

# Partner pending-action reminders. Hourly cron. Automatic sends stop after 1 December 2026 IST.
# PARTNER_COMMUNICATION_CRON_SECRET=
# Set this once at go-live. The first automatic reminder cannot send until 72 hours after it.
# Leave unset to keep automatic reminders off. Manual View Docs reminders still work.
# PARTNER_COMMUNICATION_AUTOMATION_ENABLED_AT=2026-10-24T12:00:00+05:30

# Relationship Owner daily follow-up WhatsApp digest (10:00 AM IST cron)
# RELATIONSHIP_OWNER_FOLLOWUP_CRON_SECRET=
# RELATIONSHIP_OWNER_FOLLOWUP_TEMPLATE_BASE=relationship_owner_followup_digest
# RELATIONSHIP_OWNER_FOLLOWUP_TEMPLATE_NAME=
# RELATIONSHIP_OWNER_FOLLOWUP_TEMPLATE_LANGUAGE=en
